
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id    String @id @default(uuid())
  kindeId String @unique @map("kinde_id")
  email     String @unique
  fullName String? @map("full_name")
  phoneNumber String? @map("phone_number")
  address   String?
  image String?

  posts Post[]
  comments  Comment[]
  replies   Reply[]
  postLikes PostLike[]
  commentLikes  CommentLike[] 
  replyLikes ReplyLike[]
  subscribers Subscriber[] @relation("SubscriberRelation")
  subscriptions Subscriber[] @relation("CreatorRelation") 
  shares  Share[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
}

model Post{
  id String @id @default(uuid())
  userId String @map("user_id")
  title String
  description String
  metaTag  String @map("meta_tag")
  metaKeywords  String @map("meta_keywords")
  metaDescription String @map("meta_description")
  url   String
  status Status @default(DRAFT)
  thumbnail String?
  views Int @default(0)
  publishedAt DateTime? @map("published_at")
  categories String[]

  comments  Comment[]
  likes PostLike[]
  shares Share[]


  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
}

enum Status {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model Comment{
  id  String @id @default(uuid())
  userId  String @map("user_id")
  postId String @map("post_id")

  content String

  replies Reply[]
  commentLikes CommentLike[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

model Reply{
  id String @id @default(uuid())
  userId  String @map("user_id")
  commentId   String @map("comment_id")
  parentReplyId   String? @map("parent_reply_id")
  content   String
  
  replies Reply[] @relation("ReplyThread")
  replyLikes ReplyLike[] 

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])
  parentReply Reply? @relation("ReplyThread", fields: [parentReplyId], references: [id])
}

model PostLike{
  id String @id @default(uuid())
  userId String @map("user_id")
  postId  String @map("post_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model CommentLike{
  id String @id @default(uuid())
  userId String @map("user_id")
  commentId  String @map("comment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])

  @@unique([userId, commentId])
}


model ReplyLike{
  id String @id @default(uuid())
  userId String @map("user_id")
  replyId  String @map("reply_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])
  reply Reply @relation(fields: [replyId], references: [id])

  @@unique([userId, replyId])
}


model Subscriber{
  id String @id @default(uuid())
  subscriberId  String @map("subscriber_id")
  creatorId String @map("creator_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriber User @relation("SubscriberRelation" , fields: [subscriberId], references: [id])
  creator User @relation("CreatorRelation", fields: [creatorId], references: [id])

  @@unique([subscriberId, creatorId])
}

model Share{
  id String @id @default(uuid())
  userId String @map("user_id")
  postId String @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}